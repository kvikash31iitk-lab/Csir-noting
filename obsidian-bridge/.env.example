# Copy to .env and adjust.

# Absolute path to your Obsidian vault folder (the folder that contains your
# .obsidian/ config folder). Windows example below; use forward or double
# backslashes.
VAULT_PATH=C:\Users\you\Documents\MyVault

# Notes are written into this subfolder of the vault (created if missing).
OBSIDIAN_SUBFOLDER=CSIR Notes

# Port this bridge listens on. Must match the Obsidian Bridge URL you set in
# the app's settings (⚙): http://localhost:8791
PORT=8791
