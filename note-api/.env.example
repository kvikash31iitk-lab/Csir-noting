# Copy to .env and adjust. The service reads these at startup (see the small
# loadDotEnv() helper at the top of server.js — no extra dependency needed).

# Port the Node service listens on (nginx proxies to this).
PORT=8787

# The website that is allowed to call this API (CORS). Use your real site.
ALLOWED_ORIGIN=https://notesheet.cheetsheet.tech

# Which backend generates text: "antigravity" (subscription CLI, no per-call
# billing — the default) or "openai" (real OpenAI API-key billing).
AI_PROVIDER=antigravity

# ---------------------------------------------------------------------------
# antigravity (AI_PROVIDER=antigravity) — see note-api/README.md for setup
# ---------------------------------------------------------------------------
# Path to the agy (Antigravity CLI) binary. STRONGLY prefer the full absolute
# path (e.g. /root/.local/bin/agy) — pm2's process environment often does not
# carry the interactive shell's PATH additions.
AGY_BIN=/root/.local/bin/agy

# Optional model. Must exactly match one of the names from `agy models`
# (e.g. "Gemini 3.1 Pro (High)"). Leave blank to use the CLI default.
# AGY_MODEL=Gemini 3.1 Pro (High)

# Optional extra agy args (space-separated), e.g. hardening flags.
# AGY_EXTRA_ARGS=

# Prompts at or under this many characters go straight on the CLI argument;
# longer ones are written to a temp file and referenced via @/abs/path instead
# (agy's -p flag has no STDIN fallback).
AGY_INLINE_LIMIT=100000

# ---------------------------------------------------------------------------
# openai (AI_PROVIDER=openai)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-REPLACE_ME
# OPENAI_MODEL=gpt-5.5
# OPENAI_VISION_MODEL=gpt-5.5
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_OUTPUT_TOKENS=4000
# OPENAI_OCR_MAX_OUTPUT_TOKENS=6000
# OPENAI_REASONING_EFFORT=low

# Per-request timeout in milliseconds.
TIMEOUT_MS=120000
OCR_TIMEOUT_MS=180000

# Production auth hardening.
# APP_SECRET=replace-with-openssl-rand-hex-32
# USERS=[{"username":"admin","password":"change-me","role":"admin"},{"username":"vikash","password":"change-me","role":"general"}]
