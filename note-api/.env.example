# Copy to .env and adjust. The service reads these at startup.

# Port the Node service listens on (nginx proxies to this).
PORT=8787

# The website that is allowed to call this API (CORS). Use your real site.
ALLOWED_ORIGIN=https://notesheet.cheetsheet.tech

# Path to the gemini binary. Find it with: which gemini
GEMINI_BIN=gemini

# Optional model alias/name. Leave blank to use the CLI default ("auto").
# GEMINI_MODEL=pro

# Optional extra gemini args (space-separated), e.g. hardening flags.
# GEMINI_EXTRA_ARGS=

# Per-request timeout in milliseconds.
TIMEOUT_MS=120000

# IMPORTANT: do NOT set GEMINI_API_KEY here. The service deletes it so that
# generation uses your logged-in Gemini subscription (OAuth "Login with
# Google"), not a paid API key.
