# Copy to .env and adjust. The service reads these at startup.

# Port the Node service listens on (nginx proxies to this).
PORT=8787

# The website that is allowed to call this API (CORS). Use your real site.
ALLOWED_ORIGIN=https://notesheet.cheetsheet.tech

# Path to the claude binary. Find it with: which claude
CLAUDE_BIN=claude

# Optional model. Leave blank to use the CLI default.
# CLAUDE_MODEL=sonnet

# How the system prompt is passed. Default keeps Claude Code's defaults and
# appends ours. If output behaves oddly, try: --system-prompt (full replace).
SYSTEM_PROMPT_FLAG=--append-system-prompt

# Optional extra claude args (space-separated), e.g. hardening flags.
# CLAUDE_EXTRA_ARGS=

# Per-request timeout in milliseconds.
TIMEOUT_MS=120000

# IMPORTANT: do NOT set ANTHROPIC_API_KEY here. The service deletes it so that
# generation uses your logged-in Claude subscription, not a paid API key.
